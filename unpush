import subprocess

def run_git_command(args):
    try:
        result = subprocess.run(
            ['git'] + args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding='utf-8',
            check=True
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError:
        return ""

def check_file_status(filename):
    status_output = run_git_command(['status', '--porcelain', filename])
    if status_output:
        print(f"'{filename}' はまだコミットされていません（変更がステージングまたは未ステージングです）。")
        return

    branch = run_git_command(['rev-parse', '--abbrev-ref', 'HEAD'])
    if not branch:
        print("エラー: 現在のGitブランチを取得できません（デタッチHEADの可能性もあります）。")
        return

    remote_branch = f"origin/{branch}"

    remote_exists = run_git_command(['rev-parse', '--verify', remote_branch])
    if not remote_exists:
        print(f"リモートブランチ '{remote_branch}' が見つかりません。(ローカルに情報がない場合は 'git fetch' を試してください)")
        return

    unpushed_commits = run_git_command(['log', f'{remote_branch}..HEAD', '--', filename])

    if unpushed_commits:
        print(f"'{filename}' はローカルでコミットされていますが、まだGitHubにpushされていません。")
    else:
        tracked = run_git_command(['ls-files', filename])
        if tracked:
            print(f"'{filename}' はGitHubにpush済みです！")
        else:
            print(f"'{filename}' はGitに追跡されていません。")
