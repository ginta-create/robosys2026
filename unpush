import subprocess
import sys

def run_git_command(args):
    try:
        result = subprocess.run(
            ['git'] + args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding='utf-8',
            check=True
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError:
        return ""
    except FileNotFoundError:
        print("エラー: gitコマンドが見つかりません。")
        return ""

def check_file_status(filename):
    status_output = run_git_command(['status', '--porcelain', filename])
    if status_output:
        print(f"'{filename}' はまだコミットされていません。")
        return

    branch = run_git_command(['rev-parse', '--abbrev-ref', 'HEAD'])
    if not branch:
        print("エラー: 現在のGitブランチを取得できません。")
        return

    remote_branch = f"origin/{branch}"

    remote_exists = run_git_command(['rev-parse', '--verify', remote_branch])
    if not remote_exists:
        print(f"リモートブランチ '{remote_branch}' が見つかりません。")
        return

    unpushed_commits = run_git_command(['log', f'{remote_branch}..HEAD', '--', filename])

    if unpushed_commits:
        print(f"'{filename}' はコミットされていますが、まだGitHubにpushされていません。")
    else:
        tracked = run_git_command(['ls-files', filename])
        if tracked:
            print(f"'{filename}' はGitHubにpush済みです！")
        else:
            print(f"'{filename}' はGitに追跡されていません。")

if __name__ == '__main__':
    if len(sys.argv) > 1:
        check_file_status(sys.argv[1])
    else:
        print("エラー: 引数にファイル名を指定してください。")
